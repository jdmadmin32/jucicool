{
  "name": "aquacool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "seed": "tsx server/seed.ts",
    "build": "npx tsc -b && npx vite build",
    "build:vercel": "npx vite build",
    "build:netlify": "npx vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.117.3",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.54.0",
    "postcss": "^8.5.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
